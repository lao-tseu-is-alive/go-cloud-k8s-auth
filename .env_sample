# rename this file to .env and adapt it to your needs
# you can put your personal dev env variables here and they will be used (and exported) for the Makefile target
# do not put this file in your git, it will be a bad idea to expose your password like this :-(
# in github you can use github secrets instead : https://docs.github.com/en/actions/security-guides/encrypted-secrets
# PORT is the port that the service will listen
PORT=9090
######### DATABASE CONFIGURATION #########
# for now it can be one of (memory|postgres)
DB_DRIVER=postgres
DB_HOST=127.0.0.1
# If using postgresql inside a container choose 5433 in case you already having a normal postgresql running and listening on 5432
DB_PORT=5432
DB_NAME=go_cloud_auth
DB_USER=go_cloud_auth
DB_PASSWORD=Choose_your_own_go_cloud_k8s_user_group_password
# check information in : https://www.postgresql.org/docs/current/libpq-ssl.html
DB_SSL_MODE=prefer
######### JSON WEB TOKEN CONFIGURATION #########
JWT_SECRET="Use your nice and complicated token here"
JWT_ISSUER_ID=2490AD68-3AA9-4C17-BB49-33C2F202B754
JWT_CONTEXT_KEY=yourContextKey
JWT_DURATION_MINUTES=15
JWT_AUTH_URL=/login
JWT_STATUS_URL=/status
ADMIN_USER=your_nice_admin_user
ADMIN_EMAIL=your-goadmin@example.com
ADMIN_ID=987654
ADMIN_EXTERNAL_ID=123456
ADMIN_PASSWORD=Obviously_here_again_you_can_choose_your_own
#LOG_FILE : string containing the filename to use for LOG, OR stdout or stderr, use DISCARD for no log, default is stderr
LOG_FILE=stderr
#LOG_LEVEL golog.Level Accepted values (case-insensitive): debug, info, warn, error, fatal, or their numeric equivalents (0-4).
LOG_LEVEL=warn

######### OAUTH2 CONFIGURATION #########
# Google OAuth2 provider credentials
OAUTH_GOOGLE_CLIENT_ID="your_google_client_id"
OAUTH_GOOGLE_CLIENT_SECRET="your_google_client_secret"
OAUTH_GOOGLE_REDIRECT_URL="http://localhost:9090/"

# GitHub OAuth2 provider credentials
OAUTH_GITHUB_CLIENT_ID="your_github_client_id"
OAUTH_GITHUB_CLIENT_SECRET="your_github_client_secret"
OAUTH_GITHUB_REDIRECT_URL="http://localhost:9090/"

# Microsoft OAuth2 provider credentials
OAUTH_MICROSOFT_CLIENT_ID="your_microsoft_client_id"
OAUTH_MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret"
OAUTH_MICROSOFT_REDIRECT_URL="http://localhost:9090/"
######### BROWSER SSO CONFIGURATION #########
# Externally reachable base URL of this auth service; used to build the OAuth
# browser callback URLs /auth/oauth/<provider>/callback that MUST be registered
# in each provider's developer console.
AUTH_PUBLIC_BASE_URL=http://localhost:9090
# Name of the HttpOnly session cookie set after a successful browser login.
SESSION_COOKIE_NAME=goSession
# Domain attribute of the session cookie. Leave empty for host-only (works
# across localhost ports in dev). In production set the parent domain shared
# with the module apps, e.g. .example.com
COOKIE_DOMAIN=
# Set to true in production (https). Must be false on plain-http localhost.
COOKIE_SECURE=false
# Lifetime of browser SSO sessions (Go duration format), default 30 days.
SESSION_DURATION=720h
# Comma-separated URL prefixes that modules may use as /auth/login?redirect_uri=
ALLOWED_REDIRECT_URIS=http://localhost:8080
# Comma-separated CORS origins allowed to call /auth/token with credentials.
ALLOWED_ORIGINS=https://golux.lausanne.ch,http://localhost:3000,http://localhost:8080
